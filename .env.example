# Copy to .env.local and fill in real values. That file is gitignored.
#
# Nothing here is needed to run `npm run dev` — the admin falls back to a
# built-in password and the events to a JSON file, and both say so — but all of
# it should be set before the site is deployed.

# Password for /admin. Without it the dashboard accepts "skeo-admin" and shows
# a warning until you set a real one.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any long random string; `openssl rand -hex 32`
# is a good source. Left empty, sessions are signed with a key derived from
# ADMIN_PASSWORD instead, which means changing the password logs everyone out.
ADMIN_SESSION_SECRET=

# Shared key the LMS sends as an `x-skeo-key` header when it POSTs an
# `lms_login` event to /api/track. That is the only event a browser is not
# allowed to send, because only the LMS can know somebody actually signed in.
# Until it is set, "Opened the LMS" on the dashboard counts clicks from the
# thank-you page rather than real logins.
LMS_WEBHOOK_SECRET=

# ── Database ─────────────────────────────────────────────────────────────
# skeo's OWN MongoDB. Its own cluster, sharing nothing with menler.
#
# REQUIRED IN PRODUCTION. Without it the events fall back to a JSON file under
# .data/, and on a serverless host that file is per-instance and is wiped on
# every deploy — the dashboard will under-report or come back empty. The app
# logs a warning at boot when this is missing in production.
#
# Atlas gives you the string; it looks like
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Remember to allow Vercel's egress in Atlas Network Access — 0.0.0.0/0 is the
# usual answer for serverless, with the database user's password doing the
# actual guarding.
MONGODB_URI=

# Which database inside that cluster. Defaults to "skeo", which is fine unless
# the cluster is shared with something else.
# MONGODB_DB=skeo

# ── OTP (Amplifeed) ──────────────────────────────────────────────────────
# Both are PUBLIC client keys and are meant to be in front-end code. Leave them
# unset to use the same widget menler's campaign pages use; set them only if
# skeo gets a widget of its own. A value not starting with wgt_ / otpta_ is
# ignored, so a stale key cannot pin the site to a retired widget.
# NEXT_PUBLIC_AMPLIFEED_WIDGET_ID=
# NEXT_PUBLIC_AMPLIFEED_TOKEN_AUTH=

# Local only: skip the OTP widget entirely so the checkout flow can be walked
# without sending a code. Guarded by NODE_ENV as well, so a production build
# cannot reach it. Never set this in Vercel.
# NEXT_PUBLIC_OTP_DEV_BYPASS=1

# Where the event log is written WHEN THERE IS NO DATABASE. Defaults to ./.data
# SKEO_DATA_DIR=
