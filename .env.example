# Copy to .env.local and fill in real values. That file is gitignored.
#
# Nothing here is needed to run `npm run dev` — the admin falls back to a
# built-in password and warns you about it on screen — but all three should be
# set before the site is deployed.

# Password for /admin. Without it the dashboard accepts "skeo-admin" and shows
# a warning until you set a real one.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any long random string; `openssl rand -hex 32`
# is a good source. Left empty, sessions are signed with a key derived from
# ADMIN_PASSWORD instead, which means changing the password logs everyone out.
ADMIN_SESSION_SECRET=

# Shared key the LMS sends as an `x-skeo-key` header when it POSTs an
# `lms_login` event to /api/track. That is the only event a browser is not
# allowed to send, because only the LMS can know somebody actually signed in.
# Until it is set, "Opened the LMS" on the dashboard counts clicks from the
# thank-you page rather than real logins.
LMS_WEBHOOK_SECRET=

# Where the event log is written. Defaults to ./.data
# SKEO_DATA_DIR=
